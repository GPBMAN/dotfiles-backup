{
  "layer": "top",
  "position": "top",

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "tray"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "max-length": 50
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}"
  },

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format": "RAM {}%"
  },

  "network": {
    "format-wifi": "WiFi {signalStrength}%",
    "format-ethernet": "ETH",
    "format-disconnected": "Offline"
  },

  "battery": {
    "format": "Battery: {capacity}%"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "Muted :(",
    "tooltip": false,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "myuser": {
    "exec": "whoami",
    "interval": 10,        
    "format": "User: {}"
  }
}
